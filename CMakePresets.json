{
  "version": 6,
  "configurePresets": [
    {
      "name": "windows-llvm",
      "displayName": "Windows (prebuilt LLVM + MSVC)",
      "description": "Builds against an already-installed LLVM/Clang (official Windows release at C:/LLVM, or $LLVM_ROOT). Configures in seconds - no vcpkg source build.",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreaded"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "windows-vcpkg",
      "displayName": "Windows (vcpkg + Ninja)",
      "description": "Configures KaizenTracer using vcpkg-provided LLVM/Clang libraries. First configure builds LLVM from source (1-3+ hours).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-vcpkg",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows",
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_MSVC_RUNTIME_LIBRARY": "MultiThreadedDLL"
      },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "unix-llvm",
      "displayName": "Linux/macOS (system LLVM)",
      "description": "Builds against a system LLVM/Clang (apt install llvm-dev libclang-dev, or brew install llvm).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-llvm",
      "configurePreset": "windows-llvm",
      "configuration": "Release"
    },
    {
      "name": "windows-vcpkg",
      "configurePreset": "windows-vcpkg"
    },
    {
      "name": "unix-llvm",
      "configurePreset": "unix-llvm"
    }
  ]
}
